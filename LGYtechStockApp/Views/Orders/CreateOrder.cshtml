@model LGYtechStockApp.ViewModels.CreateOrderViewModel

@{
    ViewBag.Title = "Yeni Sipariş";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="co-page">

    <div class="co-header">
        <div>
            <div class="co-crumb">Stok Yönetimi <span>/</span> Siparişler <span>/</span> Yeni Sipariş</div>
            <h1 class="co-title">Yeni Sipariş</h1>
            <p class="co-desc">Sipariş bilgilerini girin ve ürünleri belirleyin.</p>
        </div>

        <a href="@Url.Action("OrderList", "Orders")" class="co-btn-back">
            <i class="fas fa-arrow-left"></i> Siparişlere Dön
        </a>
    </div>

    @using (Html.BeginForm("CreateOrder", "Orders", FormMethod.Post, new { id = "orderForm" }))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(false, "", new { @class = "co-validation" })

        <div id="orderMessage" class="co-message" role="alert" aria-live="polite"></div>

        <div class="co-grid">

            <div class="co-main">

                <!-- Müşteri -->
                <div class="co-card">
                    <div class="co-card-head">
                        <div class="co-card-icon"><i class="fas fa-user"></i></div>
                        <div>
                            <h2 class="co-card-title">Müşteri Bilgileri</h2>
                            <span class="co-card-sub">Siparişin kime ait olduğunu belirtin.</span>
                        </div>
                    </div>

                    <div class="co-card-body">
                        <label for="CustomerName" class="co-label">Müşteri Adı <span class="co-req">*</span></label>
                        <input type="text" id="CustomerName" name="CustomerName"
                               class="co-input" maxlength="100" autocomplete="off"
                               placeholder="Müşterinin adını girin" required />
                        @Html.ValidationMessageFor(m => m.CustomerName, "", new { @class = "co-error" })
                        <small class="co-hint">Sipariş kaydında bu isim kullanılacaktır.</small>
                    </div>
                </div>

                <!-- Ürünler -->
                <div class="co-card">
                    <div class="co-card-head">
                        <div class="co-card-icon"><i class="fas fa-box"></i></div>
                        <div class="co-grow">
                            <h2 class="co-card-title">Sipariş Ürünleri</h2>
                            <span class="co-card-sub">Siparişe eklenecek ürünleri ve adetlerini seçin.</span>
                        </div>
                        <span class="co-pill" id="lineCount">1 ürün satırı</span>
                    </div>

                    <div class="co-lines-head">
                        <span>Ürün</span>
                        <span>Adet</span>
                        <span></span>
                    </div>

                    <div id="orderLines">
                        <div class="co-line">
                            <div class="co-line-product">
                                <select name="OrderLines[0].ProductId" class="co-input co-select" required>
                                    <option value="">Ürün seçin</option>
                                    @foreach (var product in Model.Products)
                                    {
                                        <option value="@product.Id" data-stock="@product.Stock">@product.Name</option>
                                    }
                                </select>
                                <span class="co-stock-label">Ürün seçildiğinde mevcut stok gösterilir.</span>
                            </div>

                            <div class="co-line-qty">
                                <input type="number" name="OrderLines[0].Quantity" class="co-input co-qty"
                                       min="1" step="1" value="1" required />
                            </div>

                            <div class="co-line-remove">
                                <button type="button" class="co-remove" title="Satırı sil" aria-label="Satırı sil">
                                    <i class="fas fa-trash-alt"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="co-add-wrap">
                        <button type="button" id="addLine" class="co-add">
                            <i class="fas fa-plus"></i> Ürün Satırı Ekle
                        </button>
                    </div>
                </div>

            </div>

            <!-- Özet -->
            <aside class="co-aside">
                <div class="co-card co-summary">
                    <div class="co-aside-label">Sipariş Özeti</div>

                    <div class="co-sum-row"><span>Müşteri</span><strong id="sumCustomer">—</strong></div>
                    <div class="co-sum-row"><span>Ürün satırı</span><strong id="sumLines">1</strong></div>
                    <div class="co-sum-row"><span>Toplam adet</span><strong id="sumQty">1</strong></div>

                    <div class="co-actions">
                        <button type="submit" class="co-btn-submit">
                            <i class="fas fa-check"></i> Siparişi Ver
                        </button>
                        <a href="@Url.Action("OrderList", "Orders")" class="co-btn-cancel">İptal</a>
                    </div>
                </div>

                <div class="co-tip">
                    <i class="fas fa-info-circle"></i>
                    <div><strong>Sipariş kontrolü</strong><br />Stok yeterliliği, sipariş kaydedilirken sunucu tarafında kontrol edilir.</div>
                </div>
            </aside>

        </div>
    }
</div>

<style>
    .co-page {
        color: var(--ink);
    }

    /* Header */
    .co-header {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: flex-end;
        gap: 16px;
        margin-bottom: 24px;
    }

    .co-crumb {
        font-size: 12px;
        font-weight: 600;
        letter-spacing: .6px;
        text-transform: uppercase;
        color: var(--muted);
        margin-bottom: 6px;
    }

        .co-crumb span {
            margin: 0 4px;
            opacity: .5;
        }

    .co-title {
        font-size: 28px;
        font-weight: 700;
        letter-spacing: -0.7px;
        margin: 0 0 4px;
    }

    .co-desc {
        margin: 0;
        color: var(--muted);
        font-size: 14px;
    }

    .co-btn-back {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 16px;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 600;
        color: #536078 !important;
        background: #fff;
        border: 1px solid var(--line);
        text-decoration: none !important;
        transition: background .15s;
    }

        .co-btn-back:hover {
            background: #f2f4f9;
        }

        .co-btn-back i {
            font-size: 12px;
        }

    /* Layout */
    .co-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 320px;
        gap: 24px;
        align-items: start;
    }

    .co-main {
        min-width: 0;
    }

    .co-card {
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 18px rgba(27, 36, 55, 0.04);
        margin-bottom: 20px;
    }

    .co-card-head {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 20px 24px;
        border-bottom: 1px solid var(--line);
    }

    .co-card-icon {
        width: 44px;
        height: 44px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        font-size: 16px;
        color: var(--primary);
        background: var(--primary-soft);
    }

    .co-grow {
        flex: 1;
        min-width: 0;
    }

    .co-card-title {
        font-size: 16px;
        font-weight: 700;
        margin: 0 0 3px;
        letter-spacing: -0.2px;
    }

    .co-card-sub {
        font-size: 13px;
        color: var(--muted);
    }

    .co-card-body {
        padding: 24px;
    }

    .co-pill {
        padding: 6px 12px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
        color: var(--primary);
        background: var(--primary-soft);
        white-space: nowrap;
    }

    /* Inputs */
    .co-label {
        display: block;
        font-size: 13px;
        font-weight: 600;
        color: #344054;
        margin: 0 0 8px;
    }

    .co-req {
        color: #e5525c;
    }

    .co-input {
        display: block;
        width: 100%;
        height: 46px;
        padding: 0 14px;
        margin: 0;
        font-family: inherit;
        font-size: 14px;
        color: var(--ink);
        background: #f6f8fc;
        border: 1px solid #f6f8fc;
        border-radius: 10px;
        outline: none;
        transition: background .15s, border-color .15s, box-shadow .15s;
    }

        .co-input::placeholder {
            color: #a3acbd;
        }

        .co-input:focus {
            background: #fff;
            border-color: var(--primary);
            box-shadow: 0 0 0 4px rgba(67, 97, 238, 0.12);
        }

        .co-input.input-validation-error {
            background: #fff7f7;
            border-color: #e5525c;
        }

    .co-hint {
        display: block;
        margin-top: 8px;
        font-size: 12px;
        color: #9aa4b6;
    }

    .co-error, .field-validation-error.co-error {
        display: block;
        margin-top: 6px;
        font-size: 12px;
        font-weight: 500;
        color: #c63f49;
    }

    .co-validation {
        margin-bottom: 16px;
        color: #c63f49;
        font-size: 13px;
    }

        .co-validation ul {
            margin: 0;
            padding-left: 18px;
        }

    .validation-summary-valid {
        display: none;
    }

    /* Lines */
    .co-lines-head, .co-line {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 150px 48px;
        gap: 16px;
        align-items: start;
        padding: 0 24px;
    }

    .co-lines-head {
        padding-top: 14px;
        padding-bottom: 12px;
        background: #fafbfe;
        border-bottom: 1px solid var(--line);
    }

        .co-lines-head span {
            font-size: 11px;
            font-weight: 700;
            letter-spacing: .7px;
            text-transform: uppercase;
            color: #8590a3;
        }

    .co-line {
        padding-top: 18px;
        padding-bottom: 18px;
        border-bottom: 1px solid #f1f3f8;
    }

    .co-line-product, .co-line-qty {
        min-width: 0;
    }

    .co-stock-label {
        display: block;
        margin-top: 8px;
        font-size: 12px;
        color: #9aa4b6;
    }

        .co-stock-label.ok {
            color: #178457;
        }

        .co-stock-label.low {
            color: #a8680a;
        }

        .co-stock-label.empty {
            color: #c63f49;
        }

    .co-remove {
        width: 46px;
        height: 46px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #f3dcdf;
        border-radius: 10px;
        font-size: 14px;
        color: #d1535d;
        background: #fff;
        cursor: pointer;
        transition: background .15s, border-color .15s;
    }

        .co-remove:hover {
            background: #fff2f3;
            border-color: #e9b9bf;
        }

    .co-add-wrap {
        padding: 18px 24px 22px;
    }

    .co-add {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 11px 18px;
        border-radius: 10px;
        font-family: inherit;
        font-size: 13px;
        font-weight: 600;
        color: var(--primary);
        background: var(--primary-soft);
        border: 1px dashed #b9c6fb;
        cursor: pointer;
        transition: background .15s, border-color .15s;
    }

        .co-add:hover {
            background: #e3e9ff;
            border-color: var(--primary);
        }

        .co-add i {
            font-size: 11px;
        }

    /* Summary */
    .co-aside {
        position: sticky;
        top: 88px;
    }

    .co-summary {
        padding: 22px;
        margin-bottom: 16px;
    }

    .co-aside-label {
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .8px;
        text-transform: uppercase;
        color: #8590a3;
        margin-bottom: 8px;
    }

    .co-sum-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        padding: 13px 0;
        font-size: 13px;
        color: var(--muted);
        border-bottom: 1px solid #f1f3f8;
    }

        .co-sum-row strong {
            color: var(--ink);
            font-size: 14px;
            text-align: right;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            max-width: 60%;
        }

    .co-actions {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin-top: 20px;
    }

    .co-btn-submit, .co-btn-cancel {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        height: 46px;
        border-radius: 10px;
        font-family: inherit;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none !important;
        transition: all .15s;
    }

    .co-btn-submit {
        color: #fff;
        border: 0;
        background: linear-gradient(135deg, #4361ee, #6a4df0);
        box-shadow: 0 6px 16px rgba(67, 97, 238, 0.28);
    }

        .co-btn-submit:hover {
            transform: translateY(-1px);
            box-shadow: 0 8px 20px rgba(67, 97, 238, 0.36);
        }

        .co-btn-submit:disabled {
            opacity: .65;
            cursor: wait;
            transform: none;
        }

    .co-btn-cancel {
        color: #536078 !important;
        background: #fff;
        border: 1px solid var(--line);
    }

        .co-btn-cancel:hover {
            background: #f2f4f9;
        }

    .co-tip {
        display: flex;
        gap: 12px;
        padding: 16px 18px;
        border-radius: 14px;
        font-size: 13px;
        line-height: 1.55;
        color: #4a5670;
        background: var(--primary-soft);
    }

        .co-tip i {
            color: var(--primary);
            margin-top: 3px;
        }

        .co-tip strong {
            color: var(--ink);
        }

    /* Message */
    .co-message {
        display: none;
        margin-bottom: 18px;
        padding: 14px 16px;
        border-radius: 12px;
        font-size: 14px;
        line-height: 1.5;
    }

        .co-message.success {
            color: #178457;
            background: #e7f7ee;
            border: 1px solid #c5ebd6;
        }

        .co-message.error {
            color: #b42323;
            background: #fff0f0;
            border: 1px solid #f1cccc;
        }

    @@media (max-width: 991px) {
        .co-grid {
            grid-template-columns: 1fr;
        }

        .co-aside {
            position: static;
        }
    }

    @@media (max-width: 575px) {
        .co-title {
            font-size: 24px;
        }

        .co-card-head, .co-card-body, .co-add-wrap {
            padding-left: 16px;
            padding-right: 16px;
        }

        .co-lines-head {
            display: none;
        }

        .co-line {
            grid-template-columns: 1fr 48px;
            padding-left: 16px;
            padding-right: 16px;
        }

        .co-line-product {
            grid-column: 1 / -1;
        }

        .co-line-qty {
            grid-column: 1;
        }

        .co-line-remove {
            grid-column: 2;
        }
    }
</style>

@section scripts {
    <script>
        $(function () {
            var defaultHint = "Ürün seçildiğinde mevcut stok gösterilir.";

            function updateSummary() {
                var count = $("#orderLines .co-line").length;
                var total = 0;

                $("#orderLines .co-qty").each(function () {
                    var v = parseInt($(this).val(), 10);
                    if (!isNaN(v) && v > 0) { total += v; }
                });

                var name = $.trim($("#CustomerName").val());

                $("#lineCount").text(count + " ürün satırı");
                $("#sumLines").text(count);
                $("#sumQty").text(total);
                $("#sumCustomer").text(name || "—");
            }

            function updateIndexes() {
                $("#orderLines .co-line").each(function (index) {
                    $(this).find(".co-select").attr("name", "OrderLines[" + index + "].ProductId");
                    $(this).find(".co-qty").attr("name", "OrderLines[" + index + "].Quantity");
                });
                updateSummary();
            }

            function resetLine(line) {
                line.find(".co-select").val("");
                line.find(".co-qty").val(1).removeAttr("max");
                line.find(".co-stock-label").removeClass("ok low empty").text(defaultHint);
            }

            $("#addLine").on("click", function () {
                var newLine = $("#orderLines .co-line:first").clone();
                resetLine(newLine);
                $("#orderLines").append(newLine);
                updateIndexes();
            });

            $("#orderLines").on("click", ".co-remove", function () {
                if ($("#orderLines .co-line").length > 1) {
                    $(this).closest(".co-line").remove();
                    updateIndexes();
                }
            });

            $("#orderLines").on("change", ".co-select", function () {
                var line = $(this).closest(".co-line");
                var stock = $(this).find("option:selected").attr("data-stock");
                var label = line.find(".co-stock-label");
                var qty = line.find(".co-qty");

                label.removeClass("ok low empty");

                if (stock !== undefined && stock !== "") {
                    var s = parseInt(stock, 10);
                    label.text("Mevcut stok: " + s + " adet");
                    label.addClass(s === 0 ? "empty" : (s <= 5 ? "low" : "ok"));
                    qty.attr("max", s);
                } else {
                    label.text(defaultHint);
                    qty.removeAttr("max");
                }
            });

            $("#orderLines").on("input change", ".co-qty", updateSummary);
            $("#CustomerName").on("input", updateSummary);

            $("#orderForm").on("submit", function (e) {
                e.preventDefault();

                var form = $(this);
                var submitButton = form.find(".co-btn-submit");
                var message = $("#orderMessage");

                message.removeClass("success error").hide().text("");

                // Tarayıcının zorunlu alan kontrollerini de koru.
                if (this.checkValidity && !this.checkValidity()) {
                    this.reportValidity();
                    return;
                }

                submitButton.prop("disabled", true).text("Kaydediliyor...");

                $.ajax({
                    url: form.attr("action"),
                    type: "POST",
                    data: form.serialize(),
                    dataType: "json",

                    success: function (response) {
                        if (response && response.success) {
                            message
                                .removeClass("error")
                                .addClass("success")
                                .text("Sipariş #" + response.orderId + " başarıyla oluşturuldu.")
                                .show();

                            // Başarılı siparişten sonra formu temizle.
                            $("#CustomerName").val("");
                            $("#orderLines .co-line").not(":first").remove();
                            resetLine($("#orderLines .co-line:first"));
                            updateIndexes();
                        } else {
                            message
                                .removeClass("success")
                                .addClass("error")
                                .text(response && response.message ? response.message : "Sipariş oluşturulamadı.")
                                .show();
                        }
                    },

                    error: function (xhr) {
                        var errorMessage = "İstek tamamlanamadı. Lütfen tekrar deneyin.";

                        if (xhr.status === 400) {
                            errorMessage = "İstek reddedildi. Anti-forgery token veya gönderilen verileri kontrol edin.";
                        } else if (xhr.status === 500) {
                            errorMessage = "Sunucu hatası oluştu. Uygulama hata kayıtlarını kontrol edin.";
                        }

                        message.removeClass("success").addClass("error").text(errorMessage).show();
                    },

                    complete: function () {
                        submitButton.prop("disabled", false).html('<i class="fas fa-check"></i> Siparişi Ver');
                    }
                });
            });

            updateSummary();
        });
    </script>
}
