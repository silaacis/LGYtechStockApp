@model IEnumerable<LGYtechStockApp.ViewModels.OrderListViewModel>

@{
    ViewBag.Title = "Sipariş Listesi";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var orders = (Model ?? Enumerable.Empty<LGYtechStockApp.ViewModels.OrderListViewModel>()).ToList();
    var orderCount = orders.Count;
    var totalAmount = orders.Sum(o => o.Total);
    var averageAmount = orderCount > 0 ? totalAmount / orderCount : 0;
}

<div class="ol-page">

    <div class="ol-header">
        <div>
            <div class="ol-crumb">Stok Yönetimi <span>/</span> Siparişler</div>
            <h1 class="ol-title">Sipariş Listesi</h1>
            <p class="ol-desc">Oluşturulan siparişleri ve toplam tutarlarını görüntüleyin.</p>
        </div>

        <a href="@Url.Action("CreateOrder", "Orders")" class="ol-btn-new">
            <i class="fas fa-plus"></i> Yeni Sipariş Oluştur
        </a>
    </div>

    <div class="ol-stats">
        <div class="ol-stat">
            <div class="ol-stat-icon ol-blue"><i class="fas fa-receipt"></i></div>
            <div>
                <div class="ol-stat-label">Toplam Sipariş</div>
                <div class="ol-stat-value">@orderCount</div>
            </div>
        </div>

        <div class="ol-stat">
            <div class="ol-stat-icon ol-green"><i class="fas fa-lira-sign"></i></div>
            <div>
                <div class="ol-stat-label">Toplam Sipariş Tutarı</div>
                <div class="ol-stat-value">@totalAmount.ToString("N2") ₺</div>
            </div>
        </div>

        <div class="ol-stat">
            <div class="ol-stat-icon ol-violet"><i class="fas fa-chart-line"></i></div>
            <div>
                <div class="ol-stat-label">Ortalama Sipariş Tutarı</div>
                <div class="ol-stat-value">@averageAmount.ToString("N2") ₺</div>
            </div>
        </div>
    </div>

    <div class="ol-card">
        <div class="ol-card-head">
            <div>
                <h2 class="ol-card-title">Tüm Siparişler</h2>
                <span class="ol-card-sub">Sipariş geçmişinin tamamı.</span>
            </div>
            <span class="ol-pill">@orderCount kayıt</span>
        </div>

        @if (orderCount > 0)
        {
            <div class="ol-table-wrap">
                <table class="ol-table">
                    <thead>
                        <tr>
                            <th>Sipariş No</th>
                            <th>Müşteri</th>
                            <th>Sipariş Tarihi</th>
                            <th>Satır Sayısı</th>
                            <th class="ol-right">Toplam Tutar</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in orders)
                        {
                            <tr>
                                <td data-label="Sipariş No">
                                    <span class="ol-no">#@order.OrderId</span>
                                </td>
                                <td data-label="Müşteri">
                                    <div class="ol-customer">
                                        <div class="ol-avatar">@(string.IsNullOrWhiteSpace(order.CustomerName) ? "?" : order.CustomerName.Trim().Substring(0, 1).ToUpper())</div>
                                        <span class="ol-customer-name">@order.CustomerName</span>
                                    </div>
                                </td>
                                <td data-label="Sipariş Tarihi">
                                    <span class="ol-date">
                                        @order.CreatedAt.ToString("dd.MM.yyyy")
                                        <small>@order.CreatedAt.ToString("HH:mm")</small>
                                    </span>
                                </td>
                                <td data-label="Satır Sayısı">
                                    <span class="ol-lines">@order.OrderLineCount</span>
                                </td>
                                <td data-label="Toplam Tutar" class="ol-right">
                                    <span class="ol-total">@order.Total.ToString("N2") ₺</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="ol-empty">
                <i class="fas fa-receipt"></i>
                <h3>Henüz sipariş bulunmuyor</h3>
                <p>Oluşturduğun siparişler burada listelenecek.</p>
                <a href="@Url.Action("CreateOrder", "Orders")" class="ol-btn-new">
                    <i class="fas fa-plus"></i> İlk Siparişi Oluştur
                </a>
            </div>
        }
    </div>
</div>

<style>
    .ol-page {
        color: var(--ink);
    }

    /* Header */
    .ol-header {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: flex-end;
        gap: 16px;
        margin-bottom: 24px;
    }

    .ol-crumb {
        font-size: 12px;
        font-weight: 600;
        letter-spacing: .6px;
        text-transform: uppercase;
        color: var(--muted);
        margin-bottom: 6px;
    }

        .ol-crumb span {
            margin: 0 4px;
            opacity: .5;
        }

    .ol-title {
        font-size: 28px;
        font-weight: 700;
        letter-spacing: -0.7px;
        margin: 0 0 4px;
    }

    .ol-desc {
        margin: 0;
        color: var(--muted);
        font-size: 14px;
    }

    .ol-btn-new {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 11px 20px;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 600;
        color: #fff !important;
        text-decoration: none !important;
        background: linear-gradient(135deg, #4361ee, #6a4df0);
        box-shadow: 0 6px 16px rgba(67, 97, 238, 0.28);
        transition: transform .15s, box-shadow .15s;
    }

        .ol-btn-new:hover {
            transform: translateY(-1px);
            box-shadow: 0 8px 20px rgba(67, 97, 238, 0.36);
        }

    /* Stats */
    .ol-stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
        margin-bottom: 24px;
    }

    .ol-stat {
        display: flex;
        align-items: center;
        gap: 16px;
        min-width: 0;
        padding: 20px 22px;
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 14px;
        transition: box-shadow .2s, transform .2s;
    }

        .ol-stat:hover {
            box-shadow: 0 8px 22px rgba(27, 36, 55, 0.06);
            transform: translateY(-1px);
        }

    .ol-stat-icon {
        width: 48px;
        height: 48px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        font-size: 18px;
    }

    .ol-blue {
        color: #4361ee;
        background: #eef1ff;
    }

    .ol-green {
        color: #178457;
        background: #e7f7ee;
    }

    .ol-violet {
        color: #7855d9;
        background: #f2edff;
    }

    .ol-stat-label {
        font-size: 13px;
        color: var(--muted);
        margin-bottom: 4px;
    }

    .ol-stat-value {
        font-size: 24px;
        font-weight: 700;
        line-height: 1.15;
        letter-spacing: -0.5px;
        overflow-wrap: anywhere;
    }

    /* Card + table */
    .ol-card {
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 18px rgba(27, 36, 55, 0.04);
    }

    .ol-card-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        padding: 20px 24px;
        border-bottom: 1px solid var(--line);
    }

    .ol-card-title {
        font-size: 17px;
        font-weight: 700;
        margin: 0 0 3px;
        letter-spacing: -0.2px;
    }

    .ol-card-sub {
        font-size: 13px;
        color: var(--muted);
    }

    .ol-pill {
        padding: 6px 12px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
        color: var(--primary);
        background: var(--primary-soft);
        white-space: nowrap;
    }

    .ol-table-wrap {
        overflow-x: auto;
    }

    .ol-table {
        width: 100%;
        border-collapse: collapse;
    }

        .ol-table thead th {
            padding: 14px 24px;
            background: #fafbfe;
            border-bottom: 1px solid var(--line);
            font-size: 11px;
            font-weight: 700;
            letter-spacing: .7px;
            text-transform: uppercase;
            text-align: left;
            color: #8590a3;
            white-space: nowrap;
        }

        .ol-table tbody td {
            padding: 16px 24px;
            border-bottom: 1px solid #f1f3f8;
            font-size: 14px;
            color: #536078;
            vertical-align: middle;
        }

        .ol-table tbody tr:last-child td {
            border-bottom: 0;
        }

        .ol-table tbody tr {
            transition: background .12s;
        }

            .ol-table tbody tr:hover {
                background: #fafbff;
            }

    .ol-right {
        text-align: right !important;
    }

    .ol-no {
        display: inline-block;
        padding: 6px 10px;
        border-radius: 7px;
        border: 1px solid #e6eaff;
        font-family: Consolas, 'SFMono-Regular', monospace;
        font-size: 12px;
        font-weight: 700;
        color: var(--primary);
        background: #f5f6ff;
    }

    .ol-customer {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .ol-avatar {
        width: 36px;
        height: 36px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 700;
        color: var(--primary);
        background: var(--primary-soft);
    }

    .ol-customer-name {
        font-weight: 600;
        color: var(--ink);
    }

    .ol-date {
        white-space: nowrap;
        color: var(--ink);
    }

        .ol-date small {
            display: block;
            margin-top: 2px;
            font-size: 12px;
            color: #9aa4b6;
        }

    .ol-lines {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 32px;
        height: 28px;
        padding: 0 10px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 700;
        color: #5b667c;
        background: #f2f4f9;
    }

    .ol-total {
        font-weight: 700;
        color: var(--ink);
        white-space: nowrap;
    }

    /* Empty */
    .ol-empty {
        padding: 56px 20px;
        text-align: center;
    }

        .ol-empty > i {
            font-size: 34px;
            color: #c3cad8;
            margin-bottom: 14px;
        }

        .ol-empty h3 {
            font-size: 17px;
            font-weight: 700;
            margin: 0 0 6px;
        }

        .ol-empty p {
            font-size: 13px;
            color: var(--muted);
            margin: 0 0 20px;
        }

    @@media (max-width: 991px) {
        .ol-stats {
            grid-template-columns: 1fr;
            gap: 12px;
        }
    }

    @@media (max-width: 767px) {
        .ol-title {
            font-size: 24px;
        }

        .ol-card-head {
            padding: 17px 16px;
        }

        .ol-table thead {
            display: none;
        }

        .ol-table, .ol-table tbody, .ol-table tr, .ol-table td {
            display: block;
            width: 100%;
        }

            .ol-table tbody tr {
                padding: 10px 16px;
                border-bottom: 1px solid var(--line);
            }

                .ol-table tbody tr:last-child {
                    border-bottom: 0;
                }

            .ol-table tbody td {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 12px;
                padding: 8px 0;
                border: 0;
                text-align: right !important;
            }

                .ol-table tbody td::before {
                    content: attr(data-label);
                    flex: 0 0 110px;
                    text-align: left;
                    font-size: 10px;
                    font-weight: 700;
                    letter-spacing: .5px;
                    text-transform: uppercase;
                    color: var(--muted);
                }
    }
</style>
