
@model IEnumerable<LGYtechStockApp.ViewModels.OrderListViewModel>

@{
    ViewBag.Title = "Sipariş Listesi";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var orders = Model ?? Enumerable.Empty<LGYtechStockApp.ViewModels.OrderListViewModel>();
    var orderCount = orders.Count();
    var totalAmount = orders.Sum(o => o.Total);
}

<style>
    .orders-page {
        padding: 28px 0 40px;
        color: #172b4d;
    }

    .orders-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 28px;
        flex-wrap: wrap;
    }

    .orders-eyebrow {
        color: #3978d4;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 1.2px;
        text-transform: uppercase;
        margin-bottom: 8px;
    }

    .orders-title {
        font-size: 28px;
        font-weight: 750;
        letter-spacing: -0.7px;
        margin: 0 0 8px;
        color: #172b4d;
    }

    .orders-subtitle {
        color: #75839a;
        margin: 0;
        font-size: 14px;
    }

    .btn-new-order {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        padding: 12px 18px;
        border-radius: 10px;
        border: 0;
        background: #2864dc;
        color: #fff !important;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none !important;
        box-shadow: 0 5px 14px rgba(40, 100, 220, .18);
        transition: transform .2s, background .2s, box-shadow .2s;
    }

        .btn-new-order:hover {
            background: #1e50ba;
            transform: translateY(-1px);
            box-shadow: 0 8px 18px rgba(40, 100, 220, .24);
        }

    .orders-stats {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
        margin-bottom: 24px;
    }

    .order-stat-card {
        background: #fff;
        border: 1px solid #e8edf5;
        border-radius: 14px;
        padding: 22px;
        display: flex;
        align-items: center;
        gap: 16px;
        box-shadow: 0 4px 18px rgba(30, 55, 90, .035);
    }

    .order-stat-icon {
        width: 48px;
        height: 48px;
        flex: 0 0 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background: #edf4ff;
        color: #2864dc;
        font-size: 22px;
    }

    .order-stat-label {
        color: #7c899e;
        font-size: 13px;
        margin-bottom: 5px;
    }

    .order-stat-value {
        color: #172b4d;
        font-size: 24px;
        font-weight: 750;
        line-height: 1.2;
        overflow-wrap: anywhere;
    }

    .orders-table-card {
        background: #fff;
        border: 1px solid #e8edf5;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 4px 18px rgba(30, 55, 90, .035);
    }

    .orders-table-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 21px 24px;
        border-bottom: 1px solid #edf0f5;
    }

    .orders-table-title {
        margin: 0;
        color: #172b4d;
        font-size: 16px;
        font-weight: 700;
    }

    .orders-count {
        background: #edf4ff;
        color: #2864dc;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }

    .orders-table {
        width: 100%;
        margin: 0;
        border-collapse: separate;
        border-spacing: 0;
    }

        .orders-table thead th {
            padding: 15px 24px;
            background: #f8faff;
            color: #7b879b;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: .65px;
            text-transform: uppercase;
            border: 0;
            white-space: nowrap;
        }

        .orders-table tbody td {
            padding: 19px 24px;
            border-top: 1px solid #f0f3f8;
            color: #43536b;
            font-size: 13px;
            vertical-align: middle;
        }

        .orders-table tbody tr {
            transition: background .15s;
        }

            .orders-table tbody tr:hover {
                background: #f9fbff;
            }

    .order-number {
        display: inline-flex;
        align-items: center;
        padding: 7px 10px;
        border-radius: 8px;
        background: #edf4ff;
        color: #2864dc;
        font-weight: 700;
        font-size: 12px;
    }

    .order-customer {
        color: #243650;
        font-weight: 650;
        font-size: 13px;
    }

    .order-date {
        color: #75839a;
        white-space: nowrap;
    }

    .order-line-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 30px;
        height: 28px;
        padding: 0 9px;
        background: #f0f4fa;
        border-radius: 8px;
        color: #52647e;
        font-weight: 700;
        font-size: 12px;
    }

    .order-total {
        color: #172b4d !important;
        font-weight: 750;
        white-space: nowrap;
        text-align: right;
    }

    .orders-empty {
        padding: 64px 20px;
        text-align: center;
    }

    .orders-empty-icon {
        width: 64px;
        height: 64px;
        margin: 0 auto 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 18px;
        background: #edf4ff;
        color: #2864dc;
        font-size: 27px;
    }

    .orders-empty h3 {
        color: #243650;
        font-size: 18px;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .orders-empty p {
        color: #7b879b;
        font-size: 13px;
        margin-bottom: 22px;
    }

    @@media (max-width: 767px) {
        .orders-page {
            padding-top: 20px;
        }

        .orders-title {
            font-size: 24px;
        }

        .orders-stats {
            grid-template-columns: 1fr;
            gap: 12px;
        }

        .order-stat-card {
            padding: 18px;
        }

        .orders-table-header {
            padding: 18px;
        }

        .orders-table thead th,
        .orders-table tbody td {
            padding: 14px 16px;
        }
    }
</style>

<div class="container orders-page">

    <div class="orders-header">
        <div>
            <div class="orders-eyebrow">STOK YÖNETİMİ / SİPARİŞLER</div>
            <h1 class="orders-title">Sipariş Listesi</h1>
            <p class="orders-subtitle">
                Oluşturulan siparişleri ve toplam tutarlarını görüntüleyin.
            </p>
        </div>

        <a href="@Url.Action("CreateOrder", "Orders")"
           class="btn-new-order">
            <span aria-hidden="true">+</span>
            Yeni Sipariş Oluştur
        </a>
    </div>

    <div class="orders-stats">
        <div class="order-stat-card">
            <div class="order-stat-icon" aria-hidden="true">▤</div>
            <div>
                <div class="order-stat-label">Toplam Sipariş</div>
                <div class="order-stat-value">@orderCount</div>
            </div>
        </div>

        <div class="order-stat-card">
            <div class="order-stat-icon" aria-hidden="true">₺</div>
            <div>
                <div class="order-stat-label">Toplam Sipariş Tutarı</div>
                <div class="order-stat-value">@totalAmount.ToString("N2") ₺</div>
            </div>
        </div>
    </div>

    <div class="orders-table-card">
        <div class="orders-table-header">
            <h2 class="orders-table-title">Tüm Siparişler</h2>
            <span class="orders-count">@orderCount kayıt</span>
        </div>

        @if (orderCount > 0)
        {
            <div class="table-responsive orders-table-wrap">
                <table class="table orders-table">
                    <thead>
                        <tr>
                            <th>Sipariş No</th>
                            <th>Müşteri</th>
                            <th>Sipariş Tarihi</th>
                            <th>Satır Sayısı</th>
                            <th>Toplam Tutar</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in orders)
                        {
                            <tr>
                                <td data-label="Sipariş No"><span class="order-number">
                                        #@order.OrderId
                                    </span>
                                </td>
                                <td data-label="Müşteri"><span class="order-customer">
                                        @order.CustomerName
                                    </span>
                                </td>
                                <td data-label="Sipariş Tarihi"><span class="order-date">
                                        @order.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                                    </span>
                                </td>
                                <td class="order-line-count-cell" data-label="Satır Sayısı"><span class="order-line-count">
                                        @order.OrderLineCount
                                    </span>
                                </td>
                                <td class="order-total" data-label="Toplam Tutar">
                                    <span>
                                        @order.Total.ToString("N2") ₺
                                    </span>
                                    
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="orders-empty">
                <div class="orders-empty-icon" aria-hidden="true">▤</div>
                <h3>Henüz sipariş bulunmuyor</h3>
                <p>Oluşturduğun siparişler burada listelenecek.</p>
                <a href="@Url.Action("CreateOrder", "Orders")"
                   class="btn-new-order">
                    + İlk Siparişi Oluştur
                </a>
            </div>
        }
    </div>
</div>
<style>
    .orders-page.container { width:100%; max-width:none; margin:0; padding:0 0 26px; color:var(--ink); }
    .orders-eyebrow { color:var(--muted); font-size:12px; font-weight:600; letter-spacing:.55px; text-transform:uppercase; }
    .orders-title { color:var(--ink); font-size:28px; font-weight:700; letter-spacing:-.7px; }
    .orders-subtitle { color:var(--muted); font-size:14px; }
    .btn-new-order { border:0; border-radius:10px; color:#fff!important; background:linear-gradient(135deg,#4361ee,#6a4df0); box-shadow:0 6px 16px rgba(67,97,238,.24); transition:transform .15s,box-shadow .15s; }
    .btn-new-order:hover { color:#fff!important; transform:translateY(-1px); box-shadow:0 8px 20px rgba(67,97,238,.32); }
    .orders-stats { gap:16px; margin-bottom:22px; }
    .order-stat-card { border:1px solid var(--line); border-radius:14px; background:#fff; box-shadow:0 4px 18px rgba(27,36,55,.035); }
    .order-stat-icon { color:var(--primary); background:var(--primary-soft); }
    .order-stat-card:nth-child(2) .order-stat-icon { color:#7855d9; background:#f2edff; }
    .order-stat-label { color:var(--muted); }
    .order-stat-value { color:var(--ink); font-size:24px; letter-spacing:-.4px; }
    .orders-table-card { border:1px solid var(--line); border-radius:16px; box-shadow:0 4px 18px rgba(27,36,55,.04); }
    .orders-table-header { border-bottom:1px solid var(--line); }
    .orders-table-title { color:var(--ink); font-size:17px; }
    .orders-count { border-radius:999px; color:var(--primary); background:var(--primary-soft); }
    .orders-table { margin-bottom:0; color:var(--ink); }
    .orders-table thead th { padding:14px 22px; border-top:0; border-bottom:1px solid var(--line); color:#8590a3; background:#fafbfe; font-size:11px; letter-spacing:.65px; text-transform:uppercase; white-space:nowrap; }
    .orders-table tbody td { padding:15px 22px; border-top:0; border-bottom:1px solid #f1f3f8; color:#536078; vertical-align:middle; }
    .orders-table tbody tr:last-child td { border-bottom:0; }
    .orders-table tbody tr:hover { background:#fafbff; }
    .order-number { border:1px solid #e6eaff; border-radius:7px; color:var(--primary); background:#f5f6ff; font-family:Consolas,'SFMono-Regular',monospace; font-weight:700; }
    .order-customer { color:var(--ink); font-weight:600; }
    .order-date { color:#536078; }
    .order-line-count { border-radius:9px; color:#5b667c; background:#f2f4f9; font-weight:700; }
    .order-total { color:var(--ink); font-weight:700; }
    .orders-empty { padding:52px 20px; }
    .orders-empty-icon { color:var(--primary); background:var(--primary-soft); }
    .orders-empty h3 { color:var(--ink); }
    .orders-empty p { color:var(--muted); }
    @@media (max-width:767px) {
        .orders-title { font-size:24px; }
        .orders-table thead th,.orders-table tbody td { padding-right:14px; padding-left:14px; }
    }
</style>
<style>
    @@media (max-width:767px) {
        .orders-table-wrap {
            overflow-x: visible;
        }

        .orders-table.table {
            display: block;
            width: 100%;
            margin: 0;
        }

        .orders-table thead {
            display: none;
        }

        .orders-table tbody {
            display: block;
            width: 100%;
        }

        .orders-table tbody tr {
            display: block;
            padding: 8px 16px;
            border-bottom: 1px solid var(--line);
        }

        .orders-table tbody tr:last-child {
            border-bottom: 0;
        }

        .orders-table.table tbody td {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            width: 100%;
            padding: 8px 0;
            border: 0;
            text-align: right !important;
        }

        .orders-table tbody td::before {
            content: attr(data-label);
            flex: 0 0 112px;
            color: var(--muted);
            font-size: 10px;
            font-weight: 700;
            letter-spacing: .45px;
            text-align: left;
            text-transform: uppercase;
        }

        .orders-table tbody td > span {
            max-width: calc(100% - 124px);
            overflow-wrap: anywhere;
        }

        .orders-table tbody td.order-line-count-cell {
            justify-content: space-between;
        }
    }
</style>