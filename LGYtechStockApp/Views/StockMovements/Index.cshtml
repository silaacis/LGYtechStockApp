@model IEnumerable<LGYtechStockApp.Models.StockMovement>

@{
    ViewBag.Title = "Stok Hareketleri";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var products = ViewBag.Products as IEnumerable<LGYtechStockApp.Models.Product>
                   ?? Enumerable.Empty<LGYtechStockApp.Models.Product>();

    int? selectedProductId = ViewBag.SelectedProductId as int?;
    var movements = (Model ?? Enumerable.Empty<LGYtechStockApp.Models.StockMovement>()).ToList();

    var movementCount = movements.Count;
    var totalEntries = movements.Where(m => m.Change > 0).Sum(m => (long)m.Change);
    var totalExits = movements.Where(m => m.Change < 0).Sum(m => Math.Abs((long)m.Change));
}

<div class="sm-page">

    <div class="sm-header">
        <div>
            <div class="sm-crumb">Stok Yönetimi <span>/</span> Hareket Geçmişi</div>
            <h1 class="sm-title">Stok Hareketleri</h1>
            <p class="sm-desc">Ürünlerin stok girişlerini, çıkışlarını ve işlem geçmişini takip edin.</p>
        </div>

        <a href="@Url.Action("ProductList", "Products")" class="sm-btn-ghost">
            <i class="fas fa-arrow-left"></i> Ürün Listesine Dön
        </a>
    </div>

    <div class="sm-stats">
        <div class="sm-stat">
            <div class="sm-stat-icon sm-blue"><i class="fas fa-exchange-alt"></i></div>
            <div>
                <div class="sm-stat-label">Toplam Hareket Kaydı</div>
                <div class="sm-stat-value">@movementCount</div>
            </div>
        </div>

        <div class="sm-stat">
            <div class="sm-stat-icon sm-green"><i class="fas fa-arrow-up"></i></div>
            <div>
                <div class="sm-stat-label">Giriş Miktarı</div>
                <div class="sm-stat-value">+@totalEntries</div>
            </div>
        </div>

        <div class="sm-stat">
            <div class="sm-stat-icon sm-red"><i class="fas fa-arrow-down"></i></div>
            <div>
                <div class="sm-stat-label">Çıkış Miktarı</div>
                <div class="sm-stat-value">−@totalExits</div>
            </div>
        </div>
    </div>

    <!-- Filtre -->
    <div class="sm-card">
        <div class="sm-filter">
            <div class="sm-filter-head">
                <div class="sm-icon"><i class="fas fa-filter"></i></div>
                <div>
                    <h2 class="sm-card-title">Hareketleri filtrele</h2>
                    <span class="sm-card-sub">İncelemek istediğin ürünü seç.</span>
                </div>
            </div>

            @using (Html.BeginForm("Index", "StockMovements", FormMethod.Get, new { @class = "sm-filter-form" }))
            {
                <div class="sm-field">
                    <label for="productId" class="sm-label">Ürün</label>
                    <select id="productId" name="productId" class="sm-select">
                        <option value="" selected="@(!selectedProductId.HasValue ? "selected" : null)">Tüm ürünler</option>

                        @foreach (var product in products)
                        {
                            <option value="@product.Id" selected="@(selectedProductId == product.Id ? "selected" : null)">
                                @product.Name
                            </option>
                        }
                    </select>
                </div>

                <button type="submit" class="sm-btn-primary">
                    <i class="fas fa-search"></i> Hareketleri Göster
                </button>

                <a href="@Url.Action("Index", "StockMovements")" class="sm-btn-ghost">Filtreyi Temizle</a>
            }
        </div>
    </div>

    <!-- Tablo -->
    <div class="sm-card">
        <div class="sm-card-top">
            <div class="sm-filter-head">
                <div class="sm-icon"><i class="fas fa-history"></i></div>
                <div>
                    <h2 class="sm-card-title">Hareket Geçmişi</h2>
                    <span class="sm-card-sub">
                        @(selectedProductId.HasValue ? "Seçilen ürünün stok hareketleri" : "Tüm ürünlerin stok hareketleri")
                    </span>
                </div>
            </div>

            <span class="sm-pill">@movementCount kayıt</span>
        </div>

        @if (movementCount > 0)
        {
            <div class="sm-table-wrap">
                <table class="sm-table">
                    <thead>
                        <tr>
                            <th>Ürün</th>
                            <th>İşlem Tarihi</th>
                            <th>Stok Değişimi</th>
                            <th>İşlem Açıklaması</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var movement in movements)
                        {
                            <tr>
                                <td data-label="Ürün">
                                    <div class="sm-product">
                                        <div class="sm-avatar">
                                            @(movement.Product != null && !string.IsNullOrWhiteSpace(movement.Product.Name)
                                                ? movement.Product.Name.Trim().Substring(0, 1).ToUpper()
                                                : "?")
                                        </div>
                                        <span class="sm-product-name">
                                            @(movement.Product != null ? movement.Product.Name : "Bilinmeyen ürün")
                                        </span>
                                    </div>
                                </td>

                                <td data-label="İşlem Tarihi">
                                    <span class="sm-date">
                                        @movement.CreatedAt.ToString("dd.MM.yyyy")
                                        <small>@movement.CreatedAt.ToString("HH:mm")</small>
                                    </span>
                                </td>

                                <td data-label="Stok Değişimi">
                                    @if (movement.Change > 0)
                                    {
                                        <span class="sm-change sm-in"><i class="fas fa-arrow-up"></i> +@movement.Change adet</span>
                                    }
                                    else if (movement.Change < 0)
                                    {
                                        <span class="sm-change sm-out"><i class="fas fa-arrow-down"></i> @movement.Change adet</span>
                                    }
                                    else
                                    {
                                        <span class="sm-change sm-neutral">0 adet</span>
                                    }
                                </td>

                                <td data-label="İşlem Açıklaması">
                                    <span class="sm-reason">
                                        @(string.IsNullOrWhiteSpace(movement.Reason) ? "Açıklama yok" : movement.Reason)
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="sm-empty">
                <i class="fas fa-exchange-alt"></i>
                <h3>Henüz stok hareketi yok</h3>
                <p>
                    @if (selectedProductId.HasValue)
                    {
                        @:Seçtiğin ürün için kayıt bulunamadı. Başka bir ürün seçebilir veya tüm hareketleri görüntüleyebilirsin.
                    }
                    else
                    {
                        @:Henüz stok hareketi kaydedilmemiş. Başarılı siparişler oluşturulduğunda hareket kayıtları burada görünecek.
                    }
                </p>
            </div>
        }
    </div>

    <div class="sm-note">
        <i class="fas fa-info-circle"></i>
        <div>
            <strong>Stok değişimi nasıl okunur?</strong>
            Negatif değerler stok çıkışını, pozitif değerler stok girişini gösterir.
            Sipariş nedeniyle oluşan hareketler, ilgili sipariş numarasıyla açıklanır.
        </div>
    </div>

</div>

<style>
    .sm-page {
        color: var(--ink);
    }

    /* Header */
    .sm-header {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: flex-end;
        gap: 16px;
        margin-bottom: 24px;
    }

    .sm-crumb {
        font-size: 12px;
        font-weight: 600;
        letter-spacing: .6px;
        text-transform: uppercase;
        color: var(--muted);
        margin-bottom: 6px;
    }

        .sm-crumb span {
            margin: 0 4px;
            opacity: .5;
        }

    .sm-title {
        font-size: 28px;
        font-weight: 700;
        letter-spacing: -0.7px;
        margin: 0 0 4px;
    }

    .sm-desc {
        margin: 0;
        color: var(--muted);
        font-size: 14px;
    }

    /* Buttons */
    .sm-btn-primary, .sm-btn-ghost {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        height: 46px;
        padding: 0 18px;
        border-radius: 10px;
        font-family: inherit;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none !important;
        white-space: nowrap;
        transition: all .15s;
    }

    .sm-btn-primary {
        color: #fff !important;
        border: 0;
        background: linear-gradient(135deg, #4361ee, #6a4df0);
        box-shadow: 0 6px 16px rgba(67, 97, 238, 0.28);
    }

        .sm-btn-primary:hover {
            transform: translateY(-1px);
            box-shadow: 0 8px 20px rgba(67, 97, 238, 0.36);
        }

    .sm-btn-ghost {
        color: #536078 !important;
        background: #fff;
        border: 1px solid var(--line);
    }

        .sm-btn-ghost:hover {
            background: #f2f4f9;
        }

        .sm-btn-ghost i, .sm-btn-primary i {
            font-size: 12px;
        }

    /* Stats */
    .sm-stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
        margin-bottom: 24px;
    }

    .sm-stat {
        display: flex;
        align-items: center;
        gap: 16px;
        min-width: 0;
        padding: 20px 22px;
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 14px;
        transition: box-shadow .2s, transform .2s;
    }

        .sm-stat:hover {
            box-shadow: 0 8px 22px rgba(27, 36, 55, 0.06);
            transform: translateY(-1px);
        }

    .sm-stat-icon {
        width: 48px;
        height: 48px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        font-size: 17px;
    }

    .sm-blue {
        color: #4361ee;
        background: #eef1ff;
    }

    .sm-green {
        color: #178457;
        background: #e7f7ee;
    }

    .sm-red {
        color: #c63f49;
        background: #ffebed;
    }

    .sm-stat-label {
        font-size: 13px;
        color: var(--muted);
        margin-bottom: 4px;
    }

    .sm-stat-value {
        font-size: 24px;
        font-weight: 700;
        line-height: 1.15;
        letter-spacing: -0.5px;
        overflow-wrap: anywhere;
    }

    /* Cards */
    .sm-card {
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 18px rgba(27, 36, 55, 0.04);
        margin-bottom: 22px;
    }

    .sm-card-top {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        padding: 20px 24px;
        border-bottom: 1px solid var(--line);
    }

    .sm-filter {
        padding: 22px 24px;
    }

    .sm-filter-head {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .sm-filter .sm-filter-head {
        margin-bottom: 20px;
    }

    .sm-icon {
        width: 42px;
        height: 42px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        font-size: 15px;
        color: var(--primary);
        background: var(--primary-soft);
    }

    .sm-card-title {
        font-size: 16px;
        font-weight: 700;
        margin: 0 0 3px;
        letter-spacing: -0.2px;
    }

    .sm-card-sub {
        font-size: 13px;
        color: var(--muted);
    }

    .sm-pill {
        padding: 6px 12px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
        color: var(--primary);
        background: var(--primary-soft);
        white-space: nowrap;
    }

    /* Filter form */
    .sm-filter-form {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        gap: 12px;
        margin: 0;
    }

    .sm-field {
        flex: 1 1 260px;
        max-width: 440px;
    }

    .sm-label {
        display: block;
        font-size: 13px;
        font-weight: 600;
        color: #344054;
        margin: 0 0 8px;
    }

    .sm-select {
        display: block;
        width: 100%;
        height: 46px;
        padding: 0 14px;
        margin: 0;
        font-family: inherit;
        font-size: 14px;
        color: var(--ink);
        background-color: #f6f8fc;
        border: 1px solid #f6f8fc;
        border-radius: 10px;
        outline: none;
        transition: background .15s, border-color .15s, box-shadow .15s;
    }

        .sm-select:focus {
            background-color: #fff;
            border-color: var(--primary);
            box-shadow: 0 0 0 4px rgba(67, 97, 238, 0.12);
        }

    /* Table */
    .sm-table-wrap {
        overflow-x: auto;
    }

    .sm-table {
        width: 100%;
        border-collapse: collapse;
    }

        .sm-table thead th {
            padding: 14px 24px;
            background: #fafbfe;
            border-bottom: 1px solid var(--line);
            font-size: 11px;
            font-weight: 700;
            letter-spacing: .7px;
            text-transform: uppercase;
            text-align: left;
            color: #8590a3;
            white-space: nowrap;
        }

        .sm-table tbody td {
            padding: 16px 24px;
            border-bottom: 1px solid #f1f3f8;
            font-size: 14px;
            color: #536078;
            vertical-align: middle;
        }

        .sm-table tbody tr:last-child td {
            border-bottom: 0;
        }

        .sm-table tbody tr {
            transition: background .12s;
        }

            .sm-table tbody tr:hover {
                background: #fafbff;
            }

    .sm-product {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 150px;
    }

    .sm-avatar {
        width: 38px;
        height: 38px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 11px;
        font-size: 15px;
        font-weight: 700;
        color: var(--primary);
        background: var(--primary-soft);
    }

    .sm-product-name {
        font-weight: 600;
        color: var(--ink);
    }

    .sm-date {
        white-space: nowrap;
        color: var(--ink);
    }

        .sm-date small {
            display: block;
            margin-top: 2px;
            font-size: 12px;
            color: #9aa4b6;
        }

    .sm-change {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        min-width: 92px;
        padding: 6px 12px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }

        .sm-change i {
            font-size: 10px;
        }

    .sm-in {
        color: #178457;
        background: #e7f7ee;
    }

    .sm-out {
        color: #c63f49;
        background: #ffebed;
    }

    .sm-neutral {
        color: #5b667c;
        background: #f2f4f9;
    }

    .sm-reason {
        line-height: 1.5;
        overflow-wrap: anywhere;
    }

    /* Empty */
    .sm-empty {
        padding: 56px 20px;
        text-align: center;
    }

        .sm-empty > i {
            font-size: 34px;
            color: #c3cad8;
            margin-bottom: 14px;
        }

        .sm-empty h3 {
            font-size: 17px;
            font-weight: 700;
            margin: 0 0 6px;
        }

        .sm-empty p {
            max-width: 400px;
            margin: 0 auto;
            font-size: 13px;
            line-height: 1.6;
            color: var(--muted);
        }

    /* Note */
    .sm-note {
        display: flex;
        gap: 12px;
        padding: 16px 18px;
        border-radius: 14px;
        font-size: 13px;
        line-height: 1.6;
        color: #4a5670;
        background: var(--primary-soft);
    }

        .sm-note > i {
            color: var(--primary);
            margin-top: 3px;
        }

        .sm-note strong {
            display: block;
            color: var(--ink);
        }

    @@media (max-width: 991px) {
        .sm-stats {
            grid-template-columns: 1fr;
            gap: 12px;
        }
    }

    @@media (max-width: 767px) {
        .sm-title {
            font-size: 24px;
        }

        .sm-card-top, .sm-filter {
            padding: 17px 16px;
        }

        .sm-field {
            max-width: none;
            flex-basis: 100%;
        }

        .sm-filter-form .sm-btn-primary, .sm-filter-form .sm-btn-ghost {
            flex: 1;
        }

        .sm-table thead {
            display: none;
        }

        .sm-table, .sm-table tbody, .sm-table tr, .sm-table td {
            display: block;
            width: 100%;
        }

            .sm-table tbody tr {
                padding: 10px 16px;
                border-bottom: 1px solid var(--line);
            }

                .sm-table tbody tr:last-child {
                    border-bottom: 0;
                }

            .sm-table tbody td {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 12px;
                padding: 8px 0;
                border: 0;
                text-align: right;
            }

                .sm-table tbody td::before {
                    content: attr(data-label);
                    flex: 0 0 110px;
                    text-align: left;
                    font-size: 10px;
                    font-weight: 700;
                    letter-spacing: .5px;
                    text-transform: uppercase;
                    color: var(--muted);
                }
    }
</style>
