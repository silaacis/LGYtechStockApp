@model LGYtechStockApp.ViewModels.ProductListViewModel
@{
    ViewBag.Title = "Ürün Listesi";
    Layout = "~/Views/Shared/_Layout.cshtml";

    int totalPages = Model.PageSize > 0
        ? (int)Math.Ceiling((double)Model.TotalCount / Model.PageSize)
        : 1;
    if (totalPages < 1) { totalPages = 1; }

    int startItem = Model.TotalCount == 0 ? 0 : (Model.CurrentPage - 1) * Model.PageSize + 1;
    int endItem = Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalCount);

    int pageStart = Math.Max(1, Model.CurrentPage - 2);
    int pageEnd = Math.Min(totalPages, Model.CurrentPage + 2);

    int lowCount = Model.Products.Count(p => p.Stock > 0 && p.Stock <= 5);
    int emptyCount = Model.Products.Count(p => p.Stock == 0);
}

<div class="product-page">

    <!-- Page Header -->
    <div class="page-header">
        <div>
            <div class="breadcrumb-text">Stok Yönetimi <span>/</span> Ürünler</div>
            <h1 class="page-title">Ürün Listesi</h1>
            <p class="page-desc">Ürünlerini ve mevcut stok durumlarını tek yerden yönet.</p>
        </div>

        <a href="/Products/AddProduct" class="btn-add">
            <i class="fas fa-plus"></i> Yeni Ürün
        </a>
    </div>

    <!-- Summary -->
    <div class="summary-grid">
        <div class="summary-card">
            <div class="summary-icon icon-blue"><i class="fas fa-box"></i></div>
            <div>
                <div class="summary-label">Toplam Ürün</div>
                <div class="summary-value">@Model.TotalCount</div>
            </div>
        </div>
        <div class="summary-card">
            <div class="summary-icon icon-amber"><i class="fas fa-exclamation-triangle"></i></div>
            <div>
                <div class="summary-label">Kritik Stok <small>(bu sayfada)</small></div>
                <div class="summary-value">@lowCount</div>
            </div>
        </div>
        <div class="summary-card">
            <div class="summary-icon icon-red"><i class="fas fa-times-circle"></i></div>
            <div>
                <div class="summary-label">Stokta Yok <small>(bu sayfada)</small></div>
                <div class="summary-value">@emptyCount</div>
            </div>
        </div>
    </div>

    <!-- Product Table -->
    <div class="product-card">
        <div class="product-card-top">
            <div>
                <h2 class="card-title">Tüm Ürünler</h2>
                <span class="card-sub">Ürün bilgilerini görüntüle ve düzenle.</span>
            </div>

            <form method="get" action="@Url.Action("ProductList", "Products")" class="search-form">
                <div class="search-box">
                    <i class="fas fa-search"></i>
                    <input type="text"
                           name="searchTerm"
                           placeholder="Ürün adına göre ara..."
                           value="@Model.SearchTerm" />
                    @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
                    {
                        <a href="@Url.Action("ProductList", "Products")" class="search-clear" title="Aramayı temizle">
                            <i class="fas fa-times"></i>
                        </a>
                    }
                </div>
                <button type="submit" class="btn-search">Ara</button>
            </form>
        </div>

        <div class="table-wrap">
            <table class="product-table">
                <thead>
                    <tr>
                        <th>Ürün</th>
                        <th>SKU</th>
                        <th>Birim Fiyat</th>
                        <th>Stok Durumu</th>
                        <th class="col-right">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Products)
                    {
                        <tr>
                            <td>
                                <div class="product-cell">
                                    <div class="product-avatar">
                                        @(string.IsNullOrEmpty(item.Name) ? "?" : item.Name.Substring(0, 1).ToUpper())
                                    </div>
                                    <div>
                                        <div class="product-name">@item.Name</div>
                                        <div class="product-subtitle">Ürün #@item.Id</div>
                                    </div>
                                </div>
                            </td>
                            <td><span class="sku-badge">@item.Sku</span></td>
                            <td class="price-cell">@item.Price.ToString("N2") ₺</td>
                            <td>
                                @if (item.Stock == 0)
                                {
                                    <span class="stock-badge stock-empty"><i class="dot"></i>Stokta Yok</span>
                                }
                                else if (item.Stock <= 5)
                                {
                                    <span class="stock-badge stock-low"><i class="dot"></i>Kritik Stok (@item.Stock)</span>
                                }
                                else
                                {
                                    <span class="stock-badge stock-available"><i class="dot"></i>Stokta Var (@item.Stock)</span>
                                }
                            </td>
                            <td class="col-right">
                                <a href="@Url.Action("EditProduct", "Products", new { id = item.Id })" class="btn-edit">
                                    <i class="fas fa-pen"></i> Düzenle
                                </a>
                            </td>
                        </tr>
                    }

                    @if (!Model.Products.Any())
                    {
                        <tr>
                            <td colspan="5">
                                <div class="empty-state">
                                    <i class="fas fa-box-open"></i>
                                    <div class="empty-title">Ürün bulunamadı</div>
                                    <div class="empty-text">Aramanı değiştirmeyi dene ya da yeni bir ürün ekle.</div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="pagination-area">
            <span class="page-info">
                <strong>@Model.TotalCount</strong> üründen <strong>@startItem–@endItem</strong> arası gösteriliyor
            </span>

            <nav aria-label="Ürün sayfaları">
                <ul class="pager">
                    <li class="@(Model.CurrentPage <= 1 ? "disabled" : "")">
                        <a href="@Url.Action("ProductList", new { searchTerm = Model.SearchTerm, page = Model.CurrentPage - 1 })">&lsaquo;</a>
                    </li>

                    @for (int i = pageStart; i <= pageEnd; i++)
                    {
                        <li class="@(i == Model.CurrentPage ? "active" : "")">
                            <a href="@Url.Action("ProductList", new { searchTerm = Model.SearchTerm, page = i })">@i</a>
                        </li>
                    }

                    <li class="@(Model.CurrentPage >= totalPages ? "disabled" : "")">
                        <a href="@Url.Action("ProductList", new { searchTerm = Model.SearchTerm, page = Model.CurrentPage + 1 })">&rsaquo;</a>
                    </li>
                </ul>
            </nav>
        </div>
    </div>
</div>

<style>
    .product-page {
        color: var(--ink);
    }

    /* ---------- Header ---------- */
    .page-header {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: flex-end;
        gap: 16px;
        margin-bottom: 24px;
    }

    .breadcrumb-text {
        font-size: 12px;
        font-weight: 600;
        letter-spacing: .6px;
        text-transform: uppercase;
        color: var(--muted);
        margin-bottom: 6px;
    }

        .breadcrumb-text span {
            margin: 0 4px;
            opacity: .5;
        }

    .page-title {
        font-size: 28px;
        font-weight: 700;
        letter-spacing: -0.7px;
        margin: 0 0 4px;
    }

    .page-desc {
        margin: 0;
        color: var(--muted);
        font-size: 14px;
    }

    .btn-add {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 11px 20px;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 600;
        color: #fff !important;
        text-decoration: none !important;
        background: linear-gradient(135deg, #4361ee, #6a4df0);
        box-shadow: 0 6px 16px rgba(67, 97, 238, 0.28);
        transition: transform .15s, box-shadow .15s;
    }

        .btn-add:hover {
            transform: translateY(-1px);
            box-shadow: 0 8px 20px rgba(67, 97, 238, 0.36);
        }

    /* ---------- Summary ---------- */
    .summary-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
        margin-bottom: 24px;
    }

    .summary-card {
        display: flex;
        align-items: center;
        gap: 16px;
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 14px;
        padding: 20px 22px;
        transition: box-shadow .2s, transform .2s;
    }

        .summary-card:hover {
            box-shadow: 0 8px 22px rgba(27, 36, 55, 0.06);
            transform: translateY(-1px);
        }

    .summary-icon {
        width: 48px;
        height: 48px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        font-size: 18px;
    }

    .icon-blue {
        color: #4361ee;
        background: #eef1ff;
    }

    .icon-amber {
        color: #d98a0b;
        background: #fff4dc;
    }

    .icon-red {
        color: #db4b55;
        background: #ffecee;
    }

    .summary-label {
        font-size: 13px;
        color: var(--muted);
        margin-bottom: 4px;
    }

        .summary-label small {
            font-size: 11px;
            opacity: .8;
        }

    .summary-value {
        font-size: 26px;
        font-weight: 700;
        line-height: 1.1;
        letter-spacing: -0.5px;
    }

    /* ---------- Card ---------- */
    .product-card {
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 18px rgba(27, 36, 55, 0.04);
    }

    .product-card-top {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        padding: 22px 24px;
        border-bottom: 1px solid var(--line);
    }

    .card-title {
        font-size: 17px;
        font-weight: 700;
        margin: 0 0 3px;
        letter-spacing: -0.2px;
    }

    .card-sub {
        font-size: 13px;
        color: var(--muted);
    }

    /* ---------- Search ---------- */
    .search-form {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 0;
    }

    .search-box {
        position: relative;
        display: flex;
        align-items: center;
    }

        .search-box > i.fa-search {
            position: absolute;
            left: 14px;
            color: #9aa4b6;
            font-size: 13px;
            pointer-events: none;
        }

        .search-box input {
            width: 300px;
            max-width: 100%;
            height: 42px;
            padding: 0 38px 0 38px;
            font-size: 14px;
            font-family: inherit;
            color: var(--ink);
            background: #f6f8fc;
            border: 1px solid transparent;
            border-radius: 10px;
            outline: none;
            transition: background .15s, border-color .15s, box-shadow .15s;
        }

            .search-box input:focus {
                background: #fff;
                border-color: var(--primary);
                box-shadow: 0 0 0 4px rgba(67, 97, 238, 0.12);
            }

    .search-clear {
        position: absolute;
        right: 12px;
        color: #9aa4b6;
        font-size: 12px;
        text-decoration: none !important;
    }

        .search-clear:hover {
            color: #db4b55;
        }

    .btn-search {
        height: 42px;
        padding: 0 20px;
        border: 0;
        border-radius: 10px;
        font-family: inherit;
        font-size: 14px;
        font-weight: 600;
        color: #fff;
        background: var(--primary);
        cursor: pointer;
        transition: background .15s;
    }

        .btn-search:hover {
            background: var(--primary-dark);
        }

    /* ---------- Table ---------- */
    .table-wrap {
        overflow-x: auto;
    }

    .product-table {
        width: 100%;
        border-collapse: collapse;
    }

        .product-table thead th {
            background: #fafbfe;
            color: #8590a3;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: .7px;
            text-transform: uppercase;
            text-align: left;
            padding: 14px 24px;
            border-bottom: 1px solid var(--line);
            white-space: nowrap;
        }

        .product-table tbody td {
            padding: 16px 24px;
            vertical-align: middle;
            border-bottom: 1px solid #f1f3f8;
            font-size: 14px;
        }

        .product-table tbody tr:last-child td {
            border-bottom: 0;
        }

        .product-table tbody tr {
            transition: background .12s;
        }

            .product-table tbody tr:hover {
                background: #fafbff;
            }

    .col-right {
        text-align: right !important;
    }

    .product-cell {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .product-avatar {
        width: 40px;
        height: 40px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 11px;
        font-weight: 700;
        font-size: 15px;
        color: var(--primary);
        background: var(--primary-soft);
    }

    .product-name {
        font-size: 14px;
        font-weight: 600;
        color: var(--ink);
    }

    .product-subtitle {
        font-size: 12px;
        color: #9aa4b6;
        margin-top: 2px;
    }

    .sku-badge {
        display: inline-block;
        padding: 5px 10px;
        border-radius: 6px;
        font-family: Consolas, 'SFMono-Regular', monospace;
        font-size: 12px;
        font-weight: 600;
        color: #5b667c;
        background: #f2f4f9;
    }

    .price-cell {
        font-weight: 600;
        white-space: nowrap;
    }

    .stock-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 6px 12px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
    }

        .stock-badge .dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            display: inline-block;
        }

    .stock-available {
        color: #178457;
        background: #e7f7ee;
    }

        .stock-available .dot {
            background: #1fb36f;
        }

    .stock-low {
        color: #a8680a;
        background: #fff3d9;
    }

        .stock-low .dot {
            background: #f0a21a;
        }

    .stock-empty {
        color: #c63f49;
        background: #ffebed;
    }

        .stock-empty .dot {
            background: #e5525c;
        }

    .btn-edit {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 8px 14px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        color: var(--primary) !important;
        background: var(--primary-soft);
        text-decoration: none !important;
        transition: background .15s, color .15s;
    }

        .btn-edit:hover {
            background: var(--primary);
            color: #fff !important;
        }

        .btn-edit i {
            font-size: 11px;
        }

    /* ---------- Empty ---------- */
    .empty-state {
        text-align: center;
        padding: 48px 16px;
        color: var(--muted);
    }

        .empty-state i {
            font-size: 34px;
            color: #c3cad8;
            margin-bottom: 12px;
        }

    .empty-title {
        font-size: 16px;
        font-weight: 600;
        color: var(--ink);
        margin-bottom: 4px;
    }

    .empty-text {
        font-size: 13px;
    }

    /* ---------- Pagination ---------- */
    .pagination-area {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 14px;
        padding: 16px 24px;
        border-top: 1px solid var(--line);
        background: #fcfdff;
    }

    .page-info {
        font-size: 13px;
        color: var(--muted);
    }

        .page-info strong {
            color: var(--ink);
            font-weight: 600;
        }

    .pager {
        display: flex;
        gap: 6px;
        list-style: none;
        margin: 0;
        padding: 0;
    }

        .pager li a {
            display: flex;
            align-items: center;
            justify-content: center;
            min-width: 36px;
            height: 36px;
            padding: 0 10px;
            border-radius: 9px;
            font-size: 13px;
            font-weight: 600;
            color: #5b667c;
            background: #fff;
            border: 1px solid var(--line);
            text-decoration: none !important;
            transition: all .15s;
        }

            .pager li a:hover {
                border-color: var(--primary);
                color: var(--primary);
            }

        .pager li.active a {
            color: #fff;
            background: var(--primary);
            border-color: var(--primary);
            box-shadow: 0 4px 10px rgba(67, 97, 238, 0.3);
        }

        .pager li.disabled a {
            pointer-events: none;
            color: #c3cad8;
            background: #f8f9fc;
        }

    /* ---------- Responsive ---------- */
    @@media (max-width: 991px) {
        .summary-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 767px) {
        .page-title {
            font-size: 24px;
        }

        .product-card-top {
            padding: 18px 16px;
        }

        .search-form {
            width: 100%;
        }

        .search-box {
            flex: 1;
        }

            .search-box input {
                width: 100%;
            }

        .product-table thead th,
        .product-table tbody td {
            padding: 13px 14px;
        }

        .pagination-area {
            padding: 14px 16px;
            flex-direction: column;
            align-items: flex-start;
        }
    }
</style>
