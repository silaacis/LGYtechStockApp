@model LGYtechStockApp.ViewModels.ProductListViewModel
@{
    ViewBag.Title = "Ürün Listesi";
    Layout = "~/Views/Shared/_Layout.cshtml";


}

<div class="container-fluid py-4 px-3 px-md-4 product-page">

    <!-- Page Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <div class="text-muted small mb-1">STOK YÖNETİMİ / ÜRÜNLER</div>
            <h2 class="page-title mb-1">Ürün Listesi</h2>
            <p class="text-muted mb-0">Ürünlerini ve mevcut stok durumlarını yönet.</p>
        </div>

        <a href="/Products/AddProduct" class="btn btn-primary add-product-btn mt-3 mt-md-0">
            <span class="mr-2">+</span> Yeni Ürün
        </a>
    </div>

    <!-- Summary -->
    <div class="row mb-4">
        <div class="col-md-4 mb-3 mb-md-0">
            <div class="summary-card">
                <div class="summary-icon icon-blue">
                    <i class="fas fa-box"></i>
                </div>
                <div>
                    <div class="summary-label">Toplam Ürün</div>
                    <div class="summary-value">@Model.Products.Count()</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Product Table -->
        <div class="product-card">
            <div class="product-card-header">
                <div>
                    <h5 class="mb-1 font-weight-bold">Tüm Ürünler</h5>
                    <span class="text-muted small">Ürün bilgilerini görüntüle ve düzenle.</span>
                </div>
            </div>

            <div class="search-area">
                <form method="get" action="@Url.Action("ProductList", "Products")">
                    <div class="search-input-wrapper">
                        <i class="fas fa-search"></i>
                        <input type="text"
                               name="searchTerm"
                               class="form-control"
                               placeholder="Ürün adına göre ara..."
                               value="@Model.SearchTerm" />

                        <button type="submit" class="btn btn-search">
                            Ara
                        </button>
                    </div>
                </form>
            </div>


            <div class="table-responsive">
                <table class="table product-table mb-0">
                    <thead>
                        <tr>
                            <th>ÜRÜN</th>
                            <th>SKU</th>
                            <th>BİRİM FİYAT</th>
                            <th>STOK DURUMU</th>
                            <th class="text-right">İŞLEMLER</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Products)
                        {
                            <tr>
                                <td>
                                    <div class="product-name">@item.Name</div>
                                    <div class="product-subtitle">Ürün @item.Id</div>
                                </td>
                                <td><span class="sku-badge">@item.Sku</span></td>
                                <td class="price-cell">@item.Price.ToString("N2") ₺</td>
                                <td>
                                    @if (item.Stock == 0)
                                    {
                                        <span class="stock-badge stock-empty">Stokta Yok</span>
                                    }
                                    else if (item.Stock <= 5)
                                    {
                                        <span class="stock-badge stock-low">Kritik Stok (@item.Stock)</span>
                                    }
                                    else
                                    {
                                        <span class="stock-badge stock-available">Stokta Var (@item.Stock)</span>
                                    }
                                </td>
                                <td class="text-right">
                                    <a href="@Url.Action("EditProduct", "Products", new {id = item.Id})" class="btn btn-outline-info">Düzenle</a>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>


            @{
                int totalPages = (int)Math.Ceiling(
                    (double)Model.TotalCount / Model.PageSize
                );

                int startItem = Model.TotalCount == 0
                    ? 0
                    : (Model.CurrentPage - 1) * Model.PageSize + 1;

                int endItem = Math.Min(
                    Model.CurrentPage * Model.PageSize,
                    Model.TotalCount
                );
            }

            <div class="pagination-area">
                <span class="text-muted small">
                    @Model.TotalCount üründen @startItem–@endItem arası gösteriliyor
                </span>

                <nav aria-label="Ürün sayfaları">
                    <ul class="pagination mb-0">
                        <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                            <a class="page-link"
                               href="@Url.Action("ProductList", new { searchTerm = Model.SearchTerm, page = Model.CurrentPage - 1 })">
                                &lsaquo;
                            </a>
                        </li>

                        @for (int i = 1; i <= totalPages; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-link"
                                   href="@Url.Action("ProductList", new { searchTerm = Model.SearchTerm, page = i })">
                                    @i
                                </a>
                            </li>
                        }

                        <li class="page-item @(Model.CurrentPage >= totalPages ? "disabled" : "")">
                            <a class="page-link"
                               href="@Url.Action("ProductList", new { searchTerm = Model.SearchTerm, page = Model.CurrentPage + 1 })">
                                &rsaquo;
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>


        </div>

<style>
    .product-page {
        background: #f7f8fc;
        min-height: calc(100vh - 60px);
        color: #202938;
    }

    .page-title {
        font-size: 27px;
        font-weight: 700;
        letter-spacing: -0.6px;
    }

    .add-product-btn {
        border-radius: 8px;
        padding: 10px 17px;
        font-weight: 600;
        background: #3659d9;
        border-color: #3659d9;
        box-shadow: 0 4px 10px rgba(54, 89, 217, 0.12);
    }

    .add-product-btn:hover {
        background: #2948bd;
        border-color: #2948bd;
    }

    .summary-card {
        display: flex;
        align-items: center;
        gap: 15px;
        background: #fff;
        border: 1px solid #edf0f5;
        border-radius: 12px;
        padding: 19px 21px;
        height: 100%;
    }

    .summary-icon {
        width: 45px;
        height: 45px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        font-size: 18px;
    }

    .icon-blue {
        color: #3659d9;
        background: #edf1ff;
    }

    .icon-green {
        color: #16845b;
        background: #e8f7ef;
    }

    .icon-red {
        color: #d64c54;
        background: #fff0f0;
    }

    .summary-label {
        font-size: 13px;
        color: #7c8798;
        margin-bottom: 4px;
    }

    .summary-value {
        font-size: 24px;
        line-height: 1.1;
        font-weight: 700;
    }

    .product-card {
        background: #fff;
        border: 1px solid #edf0f5;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 3px 12px rgba(28, 39, 60, 0.025);
    }

    .product-card-header {
        padding: 22px 24px;
        border-bottom: 1px solid #edf0f5;
    }

    .search-area {
        padding: 18px 24px;
        border-bottom: 1px solid #edf0f5;
    }

    .search-input-wrapper {
        display: flex;
        align-items: center;
        gap: 10px;
        position: relative;
    }

        .search-input-wrapper > i {
            position: absolute;
            left: 14px;
            color: #929bad;
        }

        .search-input-wrapper input {
            flex: 1;
            min-width: 0;
            padding-left: 40px;
        }

        .search-input-wrapper .btn-search {
            flex-shrink: 0;
            white-space: nowrap;
            background-color: #3659d9;
            color: #fff;
            border: 1px solid #3659d9;
            border-radius: 6px;
            padding: 6px 18px;
            font-weight: 600;
        }

            .search-input-wrapper .btn-search:hover {
                background-color: #2948bd;
                border-color: #2948bd;
                color: #fff;
            }

    .product-table thead th {
        background: #fafbfe;
        color: #8993a4;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.5px;
        padding: 15px 24px;
        border-top: 0;
        border-bottom: 1px solid #edf0f5;
        white-space: nowrap;
    }

    .product-table tbody td {
        padding: 17px 24px;
        vertical-align: middle;
        border-top: 1px solid #f0f2f6;
        font-size: 13px;
    }

    .product-table tbody tr:hover {
        background: #fbfcff;
    }

    .product-name {
        font-size: 14px;
        font-weight: 600;
        color: #263247;
    }

    .product-subtitle {
        font-size: 11px;
        color: #9aa3b2;
        margin-top: 3px;
    }

    .sku-badge {
        display: inline-block;
        background: #f4f6fa;
        color: #657187;
        border-radius: 5px;
        padding: 5px 8px;
        font-size: 11px;
        font-weight: 600;
    }

    .price-cell {
        color: #263247;
        font-weight: 600;
        white-space: nowrap;
    }

    .stock-badge {
        display: inline-block;
        padding: 6px 9px;
        border-radius: 6px;
        font-size: 11px;
        font-weight: 600;
        white-space: nowrap;
    }

    .stock-available {
        background: #eaf7ef;
        color: #208456;
    }

    .stock-low {
        background: #fff5df;
        color: #a66a08;
    }

    .stock-empty {
        background: #fff0f0;
        color: #c8444c;
    }

    .action-link {
        color: #3659d9;
        font-weight: 600;
        font-size: 12px;
        text-decoration: none;
    }

    .action-link:hover {
        color: #233fae;
        text-decoration: underline;
    }

    .pagination-area {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 17px 24px;
        border-top: 1px solid #edf0f5;
    }

    .pagination .page-link {
        color: #647087;
        border: 1px solid #e6eaf1;
        border-radius: 6px;
        margin-left: 4px;
        min-width: 34px;
        text-align: center;
    }

    .pagination .page-item.active .page-link {
        background: #3659d9;
        border-color: #3659d9;
        color: #fff;
    }

    .pagination .page-item.disabled .page-link {
        color: #c0c6d0;
        background: #fff;
    }

    @@media (max-width: 767px) {
        .product-card-header,
        .search-area {
            padding: 16px;
        }

        .product-table thead th,
        .product-table tbody td {
            padding: 13px 14px;
        }

        .pagination-area {
            padding: 15px;
            flex-direction: column;
            align-items: flex-start;
        }
    }
</style>
